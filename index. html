<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GTF Multi-Timeframe Nifty 500 & Sector Scanner (Live Real Data)</title>
    <script src="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.js"></script>
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body class="bg-gray-900 text-gray-100 font-sans min-h-screen flex flex-col">

    <!-- Header -->
    <header class="bg-gray-800 border-b border-gray-700 p-4 shadow-md">
        <div class="container mx-auto flex flex-wrap justify-between items-center">
            <h1 class="text-xl font-bold text-yellow-400 flex items-center gap-2">
                <i class="fas fa-chart-line"></i> GTF Live Scanner (Cloud API)
            </h1>
            <div class="flex gap-3 mt-2 sm:mt-0">
                <button onclick="fetchRealMarketData()" class="bg-blue-600 hover:bg-blue-700 px-4 py-2 rounded text-sm font-semibold transition">
                    <i class="fas fa-sync-alt mr-1"></i> Fetch Live Data
                </button>
                <button onclick="showSection('scanner')" class="bg-gray-700 hover:bg-gray-600 px-3 py-2 rounded text-sm transition">Scanner</button>
                <button onclick="showSection('sectors')" class="bg-gray-700 hover:bg-gray-600 px-3 py-2 rounded text-sm transition">Sector DZ/SZ</button>
                <button onclick="showSection('activeTrades')" class="bg-yellow-600 hover:bg-yellow-700 px-3 py-2 rounded text-sm font-semibold transition text-black">Active Trades (<span id="activeCount">0</span>)</button>
            </div>
        </div>
    </header>

    <!-- Main Container -->
    <main class="container mx-auto p-4 flex-grow">

        <!-- Timeframe Navigation Tabs (7 TFs) -->
        <div class="flex flex-wrap gap-2 mb-6 border-b border-gray-700 pb-3">
            <button onclick="filterTimeframe('HIT')" class="tf-btn px-3 py-1.5 rounded bg-blue-600 text-white font-medium text-sm transition">HIT (Hourly)</button>
            <button onclick="filterTimeframe('DIT')" class="tf-btn px-3 py-1.5 rounded bg-gray-800 text-gray-300 hover:bg-gray-700 text-sm transition">DIT (Daily)</button>
            <button onclick="filterTimeframe('WIT')" class="tf-btn px-3 py-1.5 rounded bg-gray-800 text-gray-300 hover:bg-gray-700 text-sm transition">WIT (Weekly)</button>
            <button onclick="filterTimeframe('MIT')" class="tf-btn px-3 py-1.5 rounded bg-gray-800 text-gray-300 hover:bg-gray-700 text-sm transition">MIT (Monthly)</button>
            <button onclick="filterTimeframe('QIT')" class="tf-btn px-3 py-1.5 rounded bg-gray-800 text-gray-300 hover:bg-gray-700 text-sm transition">QIT (Quarterly)</button>
            <button onclick="filterTimeframe('HYIT')" class="tf-btn px-3 py-1.5 rounded bg-gray-800 text-gray-300 hover:bg-gray-700 text-sm transition">HYIT (Half-Yearly)</button>
            <button onclick="filterTimeframe('YIT')" class="tf-btn px-3 py-1.5 rounded bg-gray-800 text-gray-300 hover:bg-gray-700 text-sm transition">YIT (Yearly)</button>
        </div>

        <!-- SECTION 1: Scanner Dashboard -->
        <div id="scannerSection" class="space-y-6">
            <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
                <div class="bg-gray-800 p-4 rounded-lg border border-gray-700">
                    <p class="text-sm text-gray-400">Scanned Stocks</p>
                    <h3 class="text-2xl font-bold text-white" id="statTotal">0</h3>
                </div>
                <div class="bg-gray-800 p-4 rounded-lg border border-gray-700">
                    <p class="text-sm text-gray-400">Demand Zone (DZ)</p>
                    <h3 class="text-2xl font-bold text-green-400" id="statDZ">0</h3>
                </div>
                <div class="bg-gray-800 p-4 rounded-lg border border-gray-700">
                    <p class="text-sm text-gray-400">Supply Zone (SZ)</p>
                    <h3 class="text-2xl font-bold text-red-400" id="statSZ">0</h3>
                </div>
                <div class="bg-gray-800 p-4 rounded-lg border border-gray-700">
                    <p class="text-sm text-gray-400">Macro HTF Reactions</p>
                    <h3 class="text-2xl font-bold text-yellow-400" id="statHTF">0</h3>
                </div>
            </div>

            <!-- Stocks Table -->
            <div class="bg-gray-800 rounded-lg border border-gray-700 overflow-hidden shadow-lg">
                <div class="p-4 bg-gray-750 border-b border-gray-700 flex justify-between items-center">
                    <h2 class="font-bold text-lg text-yellow-400"><span id="currentTfLabel">HIT</span> - Live Cloud Scanner</h2>
                    <input type="text" id="searchStock" placeholder="Search stock..." onkeyup="filterStocks()" class="bg-gray-700 text-sm px-3 py-1.5 rounded border border-gray-600 focus:outline-none focus:border-yellow-400 text-white">
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse text-sm">
                        <thead>
                            <tr class="bg-gray-700 text-gray-300 uppercase text-xs">
                                <th class="p-3">Stock Symbol</th>
                                <th class="p-3">LTP (₹)</th>
                                <th class="p-3">Zone Type</th>
                                <th class="p-3">Curve / Trend</th>
                                <th class="p-3">Macro HTF Reaction</th>
                                <th class="p-3">Action</th>
                            </tr>
                        </thead>
                        <tbody id="stockTableBody" class="divide-y divide-gray-700">
                            <tr><td colspan="6" class="p-4 text-center text-gray-400">Click on "Fetch Live Data" to load real prices from Cloud.</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- SECTION 2: Sector Indices DZ & SZ -->
        <div id="sectorsSection" class="hidden space-y-6">
            <div class="bg-gray-800 p-5 rounded-lg border border-gray-700">
                <h2 class="text-xl font-bold text-yellow-400 mb-4"><i class="fas fa-layer-group mr-2"></i> Sector Indices Demand & Supply Zones (DZ / SZ)</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4" id="sectorGrid"></div>
            </div>
        </div>

        <!-- SECTION 3: Active Trades Management -->
        <div id="activeTradesSection" class="hidden space-y-6">
            <div class="bg-gray-800 p-5 rounded-lg border border-gray-700">
                <h2 class="text-xl font-bold text-yellow-400 mb-4"><i class="fas fa-briefcase mr-2"></i> Active Trades & Target Management</h2>
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse text-sm">
                        <thead>
                            <tr class="bg-gray-700 text-gray-300 uppercase text-xs">
                                <th class="p-3">Stock</th>
                                <th class="p-3">Timeframe</th>
                                <th class="p-3">Entry Zone</th>
                                <th class="p-3">Target</th>
                                <th class="p-3">Status</th>
                                <th class="p-3">Manage</th>
                            </tr>
                        </thead>
                        <tbody id="activeTradesBody" class="divide-y divide-gray-700"></tbody>
                    </table>
                </div>
            </div>
        </div>

    </main>

    <!-- Footer -->
    <footer class="bg-gray-800 border-t border-gray-700 p-3 text-center text-xs text-gray-400">
        GTF System Rule: 50 SMA Trend & Macro HTF Reactions. Powered by Render & Yahoo Finance.
    </footer>

    <!-- JavaScript Logic -->
    <script>
        let activeTimeframe = 'HIT';
        let stockData = [];
        let sectorList = [
            { name: 'Nifty Bank', dz: '34,500 - 35,200 (Major DBR)', sz: '38,000 - 38,500 (RBD)' },
            { name: 'Nifty Auto', dz: '18,200 - 18,600 (RBR)', sz: '20,500 - 21,000 (DBD)' },
            { name: 'Nifty IT', dz: '32,100 - 32,800 (DBR)', sz: '36,000 - 36,400 (RBD)' },
            { name: 'Nifty Pharma', dz: '19,400 - 19,800 (RBR)', sz: '21,500 - 21,800 (DBD)' },
            { name: 'Nifty Metal', dz: '8,400 - 8,700 (DBR)', sz: '9,800 - 10,100 (RBD)' },
            { name: 'Nifty FMCG', dz: '54,000 - 55,000 (RBR)', sz: '59,000 - 60,000 (DBD)' }
        ];

        let activeTrades = JSON.parse(localStorage.getItem('gtf_active_trades')) || [];

        function showSection(sectionId) {
            document.getElementById('scannerSection').classList.add('hidden');
            document.getElementById('sectorsSection').classList.add('hidden');
            document.getElementById('activeTradesSection').classList.add('hidden');

            if(sectionId === 'scanner') document.getElementById('scannerSection').classList.remove('hidden');
            if(sectionId === 'sectors') {
                document.getElementById('sectorsSection').classList.remove('hidden');
                renderSectors();
            }
            if(sectionId === 'activeTrades') {
                document.getElementById('activeTradesSection').classList.remove('hidden');
                renderActiveTrades();
            }
        }

        async function fetchRealMarketData() {
            try {
                let tbody = document.getElementById('stockTableBody');
                tbody.innerHTML = `<tr><td colspan="6" class="p-4 text-center text-yellow-400">Fetching live data from Cloud Backend (Render)... (First request may take 30-40s as server wakes up)</td></tr>`;
                
                // रेंडर लाइव्ह बॅकएंड लिंक (इथे तुमची रेंडरची एपीआय लिंक जोडली आहे)
                let response = await fetch('https://gtfscan.onrender.com/api/scan');
                let data = await response.json();
                
                if(data && data.length > 0) {
                    stockData = data;
                    renderStocks();
                    alert('Live Market Data Loaded Successfully!');
                } else {
                    tbody.innerHTML = `<tr><td colspan="6" class="p-4 text-center text-red-400">No data received from cloud server.</td></tr>`;
                }
            } catch (error) {
                console.error('Error fetching real data:', error);
                document.getElementById('stockTableBody').innerHTML = `<tr><td colspan="6" class="p-4 text-center text-red-400">Connection error! Check your internet or Render status.</td></tr>`;
            }
        }

        function filterTimeframe(tf) {
            activeTimeframe = tf;
            document.getElementById('currentTfLabel').innerText = tf;
            
            let buttons = document.querySelectorAll('.tf-btn');
            buttons.forEach(btn => {
                if(btn.innerText.includes(tf)) {
                    btn.classList.remove('bg-gray-800', 'text-gray-300');
                    btn.classList.add('bg-blue-600', 'text-white');
                } else {
                    btn.classList.add('bg-gray-800', 'text-gray-300');
                    btn.classList.remove('bg-blue-600', 'text-white');
                }
            });
            renderStocks();
        }

        function renderStocks() {
            let tbody = document.getElementById('stockTableBody');
            tbody.innerHTML = '';

            if(stockData.length === 0) {
                tbody.innerHTML = `<tr><td colspan="6" class="p-4 text-center text-gray-400">Click on "Fetch Live Data" button above.</td></tr>`;
                return;
            }

            let filtered = stockData.filter(s => s.tf === activeTimeframe || activeTimeframe === 'HIT');
            
            document.getElementById('statTotal').innerText = stockData.length;
            document.getElementById('statDZ').innerText = stockData.filter(s => s.zone.includes('Demand')).length;
            document.getElementById('statSZ').innerText = stockData.filter(s => s.zone.includes('Supply')).length;
            document.getElementById('statHTF').innerText = stockData.filter(s => s.htf.includes('Touch') || s.htf.includes('Bounce')).length;

            filtered.forEach((stock) => {
                let isDemand = stock.zone.includes('Demand');
                let zoneColor = isDemand ? 'text-green-400' : 'text-red-400';
                
                let row = `
                    <tr class="hover:bg-gray-750 transition">
                        <td class="p-3 font-bold text-white">
                            ${stock.symbol} <span class="text-xs text-gray-400 font-normal">(${stock.sector})</span>
                        </td>
                        <td class="p-3">₹${stock.ltp}</td>
                        <td class="p-3 font-semibold ${zoneColor}">${stock.zone}</td>
                        <td class="p-3 text-gray-300">${stock.trend}</td>
                        <td class="p-3 text-yellow-400 text-xs font-mono">${stock.htf}</td>
                        <td class="p-3">
                            <button onclick="addToActive('${stock.symbol}', '${stock.tf}', '${stock.zone}')" class="bg-green-600 hover:bg-green-700 px-2.5 py-1 rounded text-xs font-semibold transition text-white">
                                <i class="fas fa-plus mr-1"></i> Add Trade
                            </button>
                            <a href="https://trade.dhan.co" target="_blank" class="ml-2 bg-gray-700 hover:bg-gray-600 px-2 py-1 rounded text-xs text-blue-300 transition">Dhan Chart</a>
                        </td>
                    </tr>
                `;
                tbody.innerHTML += row;
            });
        }

        function renderSectors() {
            let grid = document.getElementById('sectorGrid');
            grid.innerHTML = '';
            sectorList.forEach(sec => {
                grid.innerHTML += `
                    <div class="bg-gray-750 p-4 rounded-lg border border-gray-700">
                        <h3 class="font-bold text-yellow-400 text-lg mb-2">${sec.name}</h3>
                        <p class="text-xs text-gray-400 mb-1">Demand Zones (DZ):</p>
                        <div class="bg-green-900 bg-opacity-30 border border-green-700 p-2 rounded text-green-300 text-xs mb-3">${sec.dz}</div>
                        <p class="text-xs text-gray-400 mb-1">Supply Zones (SZ):</p>
                        <div class="bg-red-900 bg-opacity-30 border border-red-700 p-2 rounded text-red-300 text-xs">${sec.sz}</div>
                    </div>
                `;
            });
        }

        function addToActive(symbol, tf, zone) {
            if(!activeTrades.some(t => t.symbol === symbol)) {
                activeTrades.push({ symbol, tf, zone, status: 'Active' });
                localStorage.setItem('gtf_active_trades', JSON.stringify(activeTrades));
                updateActiveCount();
                alert(symbol + ' added to Active Trades successfully!');
            } else {
                alert(symbol + ' is already in Active Trades.');
            }
        }

        function renderActiveTrades() {
            let tbody = document.getElementById('activeTradesBody');
            tbody.innerHTML = '';
            
            if(activeTrades.length === 0) {
                tbody.innerHTML = `<tr><td colspan="6" class="p-4 text-center text-gray-500">No active trades found. Add from scanner.</td></tr>`;
                return;
            }

            activeTrades.forEach((trade, index) => {
                tbody.innerHTML += `
                    <tr class="hover:bg-gray-750 transition">
                        <td class="p-3 font-bold text-white">${trade.symbol}</td>
                        <td class="p-3">${trade.tf}</td>
                        <td class="p-3 text-green-400">${trade.zone}</td>
                        <td class="p-3 text-yellow-400">Target 1:2 / 1:3 Active</td>
                        <td class="p-3"><span class="bg-green-800 text-green-200 px-2 py-0.5 rounded text-xs">Running</span></td>
                        <td class="p-3">
                            <button onclick="removeActiveTrade(${index})" class="bg-red-600 hover:bg-red-700 px-2.5 py-1 rounded text-xs font-semibold text-white transition">
                                <i class="fas fa-check mr-1"></i> Target Hit & Close
                            </button>
                        </td>
                    </tr>
                `;
            });
        }

        function removeActiveTrade(index) {
            activeTrades.splice(index, 1);
            localStorage.setItem('gtf_active_trades', JSON.stringify(activeTrades));
            renderActiveTrades();
            updateActiveCount();
        }

        function updateActiveCount() {
            document.getElementById('activeCount').innerText = activeTrades.length;
        }

        function filterStocks() {
            let query = document.getElementById('searchStock').value.toLowerCase();
            let rows = document.querySelectorAll('#stockTableBody tr');
            rows.forEach(row => {
                let text = row.innerText.toLowerCase();
                row.style.display = text.includes(query) ? '' : 'none';
            });
        }

        updateActiveCount();
    </script>
</body>
</html>
